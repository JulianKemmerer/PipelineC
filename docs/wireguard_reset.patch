+++ b/src/chacha20poly1305/tb_common_sim.py	2026-11-07 12:02:59.711233068 -0500
@@ -29,6 +29,38 @@
 STRESS = param("TB_STRESS", False, help="random testbenches: 20 directed packets, input gaps and output backpressure")
 
 
+# Mid-run resets (-D TB_MID_RESETS=60,140): chacha20poly1305_tb.py pulses wg_rst
+# for one cycle at the first cycle at or after each of these in which some
+# packet is part way into the DUT (and in cycle 0, as the simulator otherwise
+# would). A reset loses every packet not yet checked, so each random testbench
+# sends those again, in order, and expects each once (resend_lost below).
+MID_RESETS = tuple(
+    int(c)
+    for c in str(param("TB_MID_RESETS", "", help="random testbenches: cycles of mid-packet wg_rst pulses, e.g. 60,140")).split(",")
+    if c.strip()
+)
+# The reset driver's schedule and record: requested cycles not yet reached,
+# and the cycles a mid-run reset fired in
+RESET_STATE = {"cycle": 0, "pending": list(MID_RESETS), "fired": []}
+# Each random testbench's ConvergedAxisSource, so the driver can tell whether
+# a packet is part way in
+SOURCES = []
+
+
+def resend_lost(src, scoreboard, started, n_checked):
+    """After a reset: forget what `src` and `scoreboard` hold, then send again
+    every packet started (`started`: (frame, expected, meta) per packet, in
+    order) and not yet checked (the first `n_checked` were). Returns how many
+    were sent again."""
+    src.clear()
+    scoreboard.clear()
+    lost = started[n_checked:]
+    for frame, expected, meta in lost:
+        scoreboard.expect(expected, **meta)
+        src.send(frame)
+    return len(lost)
+
+
 def input_paused(direction, cycle):
     offset = 0 if direction == "encrypt" else 9
     return STRESS and (cycle + offset) % 37 < 6
